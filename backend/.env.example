# AgentGuard runtime configuration
AGENTGUARD_ENV=development
AGENTGUARD_CORS_ORIGINS=http://localhost:3000
AGENTGUARD_POLICY_VERSION=2026.09
AGENTGUARD_RATE_LIMIT=120
AGENTGUARD_RATE_LIMIT_WINDOW=60

# Supabase server-side credentials. Never commit the real secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME

# Optional API protection during development. Required in production.
AGENTGUARD_API_KEY=

# Optional role-based operator keys. Format: key:role,key:role
# Roles: admin, reviewer, viewer. The legacy API key above is admin.
AGENTGUARD_OPERATORS=

# Configured outbound MCP servers: name=https://host/mcp,name2=https://host/mcp
# Only HTTPS endpoints are accepted, except localhost development endpoints.
AGENTGUARD_MCP_SERVERS=
AGENTGUARD_MCP_TOKENS=

# SentinelForge: optional YAML policy pack (defaults to the built-in fintech rules).
# A configured file that fails validation stops startup instead of silently falling back.
AGENTGUARD_POLICY_FILE=policy/rules/fintech_support.yaml

# SentinelForge: LLM-backed agent version (support-agent-llm). Any OpenAI-compatible endpoint,
# e.g. https://api.openai.com/v1 or Gemini's https://generativelanguage.googleapis.com/v1beta/openai
SENTINELFORGE_LLM_API_KEY=
SENTINELFORGE_LLM_BASE_URL=https://api.openai.com/v1
SENTINELFORGE_LLM_MODEL=gpt-4o-mini
