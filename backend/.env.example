# AgentGuard runtime configuration
AGENTGUARD_ENV=development
AGENTGUARD_CORS_ORIGINS=http://localhost:3000
AGENTGUARD_POLICY_VERSION=2026.09

# Supabase server-side credentials. Never commit the real secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME

# Optional API protection for the AgentGuard API itself.
AGENTGUARD_API_KEY=
